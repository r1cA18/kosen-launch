{
  "name": "kosen-launch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:edit": "UI_EDITOR=1 bun scripts/dev.ts",
    "start": "bun dist/server.js",
    "check": "bun --bun tsc --noEmit",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "mcp": "bun src/mcp.ts",
    "format": "bun --bun prettier --write src tests scripts public docs README.md AGENTS.md package.json tsconfig.json",
    "format:check": "bun --bun prettier --check src tests scripts public docs README.md AGENTS.md package.json tsconfig.json",
    "assets:build": "bun scripts/assets.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/cli": "4.3.4",
    "@types/bun": "1.4.4",
    "daisyui": "5.7.50",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  }
}
